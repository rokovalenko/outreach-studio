@* One event count in a window, for example reward claimed at least 2 times in the last 30 days. *@

<MudPaper Outlined="true" Class="pa-2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
        <MudSwitch T="bool" Value="_negated" ValueChanged="SetNegated" Label="not" Color="Color.Warning" Size="Size.Small" Disabled="Disabled" />

        <MudSelect T="EventType" Value="_clause.Event" ValueChanged="SetEvent" ToStringFunc="RuleText.EventLabel"
                   Label="Event" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="Disabled" Style="min-width:190px">
            @foreach (var known in UserSchema.Events)
            {
                <MudSelectItem T="EventType" Value="@known.Type">@known.Label</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="CompareOp" Value="_clause.Op" ValueChanged="SetOperator" ToStringFunc="RuleText.CountOperatorLabel"
                   Label="Count" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Disabled="Disabled" Style="min-width:120px">
            @foreach (var op in RuleText.CountOps)
            {
                <MudSelectItem T="CompareOp" Value="@op">@RuleText.CountOperatorLabel(op)</MudSelectItem>
            }
        </MudSelect>

        <MudNumericField T="int" Value="_clause.Count" ValueChanged="SetCount" Min="0" Label="Times"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="Disabled" Style="min-width:120px" />

        <MudNumericField T="int" Value="_clause.WindowDays" ValueChanged="SetWindow" Min="1" Label="In the last days"
                         Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="Disabled" Style="min-width:120px" />

        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="OnRemove" Disabled="Disabled" />
    </MudStack>
</MudPaper>

@code {
    /// <summary>The clause, which may be wrapped in a Not.</summary>
    [Parameter, EditorRequired]
    public Rule Rule { get; set; } = default!;

    [Parameter]
    public EventCallback<Rule> RuleChanged { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    private EventCountInWindow _clause = new(EventType.Login, CompareOp.Gte, 1, 30);
    private bool _negated;

    protected override void OnParametersSet()
    {
        var (inner, negated) = RuleEdit.Unwrap(Rule);
        _clause = inner as EventCountInWindow ?? RuleEdit.NewEvent();
        _negated = negated;
    }

    private Task Emit(EventCountInWindow clause) => RuleChanged.InvokeAsync(RuleEdit.Wrap(clause, _negated));

    private Task SetNegated(bool negated) => RuleChanged.InvokeAsync(RuleEdit.Wrap(_clause, negated));

    private Task SetEvent(EventType type) => Emit(_clause with { Event = type });

    private Task SetOperator(CompareOp op) => Emit(_clause with { Op = op });

    private Task SetCount(int count) => Emit(_clause with { Count = Math.Max(count, 0) });

    private Task SetWindow(int days) => Emit(_clause with { WindowDays = Math.Max(days, 1) });
}
