@inherits LayoutComponentBase

<MudThemeProvider Theme="Theme" IsDarkMode="true" />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudText Typo="Typo.subtitle1"><b>Outreach Studio</b></MudText>
        <MudText Typo="Typo.caption" Class="ml-3 mud-text-secondary">Loyalty campaign builder</MudText>
        <MudSpacer />
        <AboutPopover />
    </MudAppBar>
    <MudDrawer Open="true" ClipMode="DrawerClipMode.Always" Elevation="0" Variant="DrawerVariant.Persistent" Width="220px">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pt-12 pa-6">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Something went wrong.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // One dark palette with cyan as the only accent. The font stack is set on every typo variant
    // because each one has its own CSS variable, and there is no web font to download.
    private static readonly string[] Font =
        ["system-ui", "-apple-system", "Segoe UI", "Helvetica Neue", "Arial", "sans-serif"];

    private static readonly PaletteDark Palette = new()
    {
        Primary = "#22d3ee",
        PrimaryContrastText = "#0b0e11",
        Secondary = "#94a3b8",
        Tertiary = "#22d3ee",
        Background = "#0f1216",
        BackgroundGray = "#0b0e11",
        Surface = "#161a20",
        AppbarBackground = "#0b0e11",
        AppbarText = "#e6eaf0",
        DrawerBackground = "#0b0e11",
        DrawerText = "#94a3b8",
        DrawerIcon = "#94a3b8",
        TextPrimary = "#e6eaf0",
        TextSecondary = "#94a3b8",
        TextDisabled = "#5b6673",
        ActionDefault = "#94a3b8",
        ActionDisabled = "#5b667399",
        ActionDisabledBackground = "#5b667333",
        Info = "#60a5fa",
        Success = "#4ade80",
        Warning = "#fbbf24",
        Error = "#f87171",
        Dark = "#0b0e11",
        LinesDefault = "#242b33",
        LinesInputs = "#2e3843",
        TableLines = "#242b33",
        TableHover = "#1b2026",
        Divider = "#242b33",
        GrayLight = "#1b2026",
        GrayLighter = "#161a20",
        OverlayDark = "#0b0e11cc",
    };

    private static readonly MudTheme Theme = new()
    {
        PaletteDark = Palette,
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = Font },
            H1 = new H1Typography { FontFamily = Font },
            H2 = new H2Typography { FontFamily = Font },
            H3 = new H3Typography { FontFamily = Font },
            H4 = new H4Typography { FontFamily = Font },
            H5 = new H5Typography { FontFamily = Font },
            H6 = new H6Typography { FontFamily = Font },
            Subtitle1 = new Subtitle1Typography { FontFamily = Font },
            Subtitle2 = new Subtitle2Typography { FontFamily = Font },
            Body1 = new Body1Typography { FontFamily = Font },
            Body2 = new Body2Typography { FontFamily = Font },
            Button = new ButtonTypography { FontFamily = Font, TextTransform = "none" },
            Caption = new CaptionTypography { FontFamily = Font },
            Overline = new OverlineTypography { FontFamily = Font },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" },
    };
}
