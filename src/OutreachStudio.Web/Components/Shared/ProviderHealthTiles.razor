@inject ProviderHealth Health

<MudGrid Spacing="3">
    @foreach (var provider in ProviderHealth.Providers)
    {
        var recent = Recent.FirstOrDefault(s => s.Provider == provider);
        var fallback = Fallback.FirstOrDefault(s => s.Provider == provider);
        var shown = recent is { Calls: > 0 } ? recent : fallback;
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-3" Outlined="true">
                <MudText Typo="Typo.caption" Class="tile-label mud-text-secondary">@provider</MudText>
                @if (shown is null || shown.Calls == 0)
                {
                    <MudText Typo="Typo.h6">no calls yet</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Nothing in the last 24 h either</MudText>
                }
                else
                {
                    <MudText Typo="Typo.h6" Class="num" Color="@Tone(shown.SuccessRate)">@Format.Share(shown.SuccessRate)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary num">
                        @Format.Number(shown.Calls) calls, median @shown.MedianMs ms
                    </MudText>
                    @if (recent is null || recent.Calls == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            No calls in the last 15 minutes, showing the last 24 h
                        </MudText>
                    }
                }
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private IReadOnlyList<ProviderStats> Recent = [];
    private IReadOnlyList<ProviderStats> Fallback = [];

    protected override async Task OnInitializedAsync()
    {
        Recent = await Health.ReadAsync(ProviderHealth.Recent, CancellationToken.None);
        Fallback = await Health.ReadAsync(ProviderHealth.Fallback, CancellationToken.None);
    }

    /// <summary>Called by the live board after a burst of sends, so the tiles do not go stale.</summary>
    public async Task RefreshAsync()
    {
        await OnInitializedAsync();
        StateHasChanged();
    }

    private static Color Tone(double rate) => rate switch
    {
        >= 0.98 => Color.Success,
        >= 0.9 => Color.Warning,
        _ => Color.Error,
    };
}
