<MudPaper Class="pa-3" Outlined="true">
    <MudText Typo="Typo.caption" Class="tile-label mud-text-secondary">@Label</MudText>
    <MudText Typo="Typo.h6" Class="num" Color="@Tone">@Value</MudText>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@Hint</MudText>
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter, EditorRequired] public string Value { get; set; } = "";

    [Parameter] public string? Hint { get; set; }

    [Parameter] public Color Tone { get; set; } = Color.Inherit;
}
